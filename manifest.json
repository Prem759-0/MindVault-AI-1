{
  "manifest_version": 3,
  "name": "MindVault AI",
  "version": "1.0.0",
  "description": "AI browsing memory assistant, focus analytics, and smart website summarizer.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open MindVault AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
